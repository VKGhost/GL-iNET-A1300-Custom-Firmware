config general 'global'
	option enable '0'
	option access 'ACCEPT'
	option masq '1'

config service 'vpn'
	option auth 'SHA256'
	option proto 'udp'
	option port '1194'
	option dev 'ovpnserver'
	option dev_type 'tun'
	option cipher 'AES-256-GCM'
	option subnetv4 '10.8.0.0'
	option mask '255.255.255.0'
