				}
			};
		}
	},

	save_network_dns: {
		args: {
			section_type: "",
			data: {}
		},
		call: function(req) {
			let stype = req.args?.section_type || '';
			let d = req.args?.data || {};
			let c = cursor();

			if (stype == 'lan') {
				if (d.ipaddr) c.set('network', 'lan', 'ipaddr', d.ipaddr);
				if (d.netmask) c.set('network', 'lan', 'netmask', d.netmask);
				if (d.dhcp_start != null) c.set('dhcp', 'lan', 'start', String(int(d.dhcp_start)));
				if (d.dhcp_limit != null) c.set('dhcp', 'lan', 'limit', String(int(d.dhcp_limit)));
				if (d.dhcp_leasetime) c.set('dhcp', 'lan', 'leasetime', d.dhcp_leasetime);
				if (d.dhcp_ignore != null) c.set('dhcp', 'lan', 'ignore', d.dhcp_ignore ? '1' : '0');
				c.commit('network');
				c.commit('dhcp');
				run_bg('/etc/init.d/dnsmasq reload; /etc/init.d/network reload');
			} else if (stype == 'dns') {
				let mode = d.mode || 'auto';
				c.set('gl-dns', 'dns', 'mode', mode);
				if (d.manual_dns1 != null) c.set('gl-dns', 'dns', 'manual_dns1', d.manual_dns1);
				if (d.manual_dns2 != null) c.set('gl-dns', 'dns', 'manual_dns2', d.manual_dns2);
				if (d.dot_provider) c.set('gl-dns', 'dns', 'dot_provider', d.dot_provider);
				if (d.doh_provider) c.set('gl-dns', 'dns', 'doh_provider', d.doh_provider);
				c.set('gl-dns', 'dns', 'override_vpn', d.override_vpn ? '1' : '0');
				c.set('gl-dns', 'dns', 'force_dns', d.force_dns ? '1' : '0');
				c.set('gl-dns', 'dns', 'rebind_protection', d.rebind_protection ? '1' : '0');
				c.set('dhcp', '@dnsmasq[0]', 'rebind_protection', d.rebind_protection ? '1' : '0');

				if (mode == 'manual') {
					let servers = [];
					if (d.manual_dns1) push(servers, d.manual_dns1);
					if (d.manual_dns2) push(servers, d.manual_dns2);
					c.set('dhcp', '@dnsmasq[0]', 'noresolv', '1');
					c.set('dhcp', '@dnsmasq[0]', 'server', servers);
				} else {
					c.delete('dhcp', '@dnsmasq[0]', 'noresolv');
					c.delete('dhcp', '@dnsmasq[0]', 'server');
				}

				if (d.agh_enabled != null) {
					c.set('adguardhome', 'config', 'enabled', d.agh_enabled ? '1' : '0');
					c.set('adguardhome', 'config', 'handle_client_requests', d.agh_handle_clients ? '1' : '0');
					c.commit('adguardhome');
				}

				c.commit('gl-dns');
				c.commit('dhcp');
				run_bg('/etc/init.d/dnsmasq reload; /etc/init.d/gl-firewall-addons reload');
			} else if (stype == 'ipv6') {
				let en = !!d.enabled;
				c.set('glipv6', 'globals', 'enabled', en ? '1' : '0');
				if (d.wan_addrmode) c.set('glipv6', 'wan', 'addrmode', d.wan_addrmode);
				if (d.lan_mode) c.set('glipv6', 'lan', 'mode', d.lan_mode);
				c.set('network', 'wan6', 'disabled', en ? '0' : '1');
				c.commit('glipv6');
				c.commit('network');
				run_bg('/etc/init.d/network reload');
			} else if (stype == 'edgerouter') {
				c.set('edgerouter', 'global', 'enabled', d.enabled ? '1' : '0');
				c.set('edgerouter', 'global', 'force_dns', d.force_dns ? '1' : '0');
				if (d.main_router_ip != null) c.set('edgerouter', 'global', 'main_router_ip', d.main_router_ip);
				c.commit('edgerouter');
				run_bg('/etc/init.d/gl-firewall-addons reload');
			}

			return { ok: true };
		}
	},

