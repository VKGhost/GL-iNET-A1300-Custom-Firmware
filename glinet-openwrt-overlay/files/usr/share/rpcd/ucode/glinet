	save_system_hardware: {
		args: {
			section_type: "",
			data: {}
		},
		call: function(req) {
			let stype = req.args?.section_type || '';
			let d = req.args?.data || {};
			let c = cursor();

			if (stype == 'hardware') {
				if (d.switch_func) {
					c.set('switch-button', 'main', 'func', d.switch_func);
					c.commit('switch-button');
				}
				if (d.led_enable != null) {
					c.set('gl_led', 'global', 'led_enable', d.led_enable ? '1' : '0');
					if (d.led_mode) c.set('gl_led', 'global', 'led_mode', d.led_mode);
					if (d.led_schedule != null) c.set('gl_led', 'global', 'schedule_enable', d.led_schedule ? '1' : '0');
					if (d.led_start) c.set('gl_led', 'global', 'schedule_start', d.led_start);
					if (d.led_end) c.set('gl_led', 'global', 'schedule_end', d.led_end);
					c.commit('gl_led');
					run_bg('/usr/sbin/gl-led-ctl');
				}
				if (d.usb_power != null) {
					let val = d.usb_power ? '1' : '0';
					c.set('glconfig', 'general', 'usb_power', val);
					writefile('/sys/class/gpio/usb_power/value', val);
				}
				if (d.netmode) {
					c.set('glconfig', 'general', 'mode', d.netmode);
					if (d.netmode == 'ap') {
						c.set('dhcp', 'lan', 'ignore', '1');
					} else if (d.netmode == 'router') {
						c.set('dhcp', 'lan', 'ignore', '0');
					}
					c.commit('dhcp');
				}
				c.commit('glconfig');
			} else if (stype == 'nas_cloud') {
				if (d.dlna_enabled != null) {
					c.set('minidlna', 'config', 'enabled', d.dlna_enabled ? '1' : '0');
					if (d.dlna_name) c.set('minidlna', 'config', 'friendly_name', d.dlna_name);
					c.commit('minidlna');
				}
				if (d.rtty_enable != null) {
					c.set('gl-cloud', 'cloud', 'rtty_enable', d.rtty_enable ? '1' : '0');
					if (d.rtty_host != null) c.set('gl-cloud', 'cloud', 'rtty_host', d.rtty_host);
					if (d.rtty_port != null) c.set('gl-cloud', 'cloud', 'rtty_port', d.rtty_port);
					if (d.rtty_token != null) c.set('gl-cloud', 'cloud', 'rtty_token', d.rtty_token);
					if (d.rtty_id != null) c.set('gl-cloud', 'cloud', 'rtty_id', d.rtty_id);
					c.commit('gl-cloud');
				}
				if (d.ddns_enabled != null) {
					c.set('gl_ddns', 'glddns', 'enabled', d.ddns_enabled ? '1' : '0');
					if (d.ddns_domain != null) c.set('gl_ddns', 'glddns', 'domain', d.ddns_domain);
					c.commit('gl_ddns');
				}
				if (d.reboot_enable != null) {
					c.set('gl_timer', 'reboot', 'enable', d.reboot_enable ? '1' : '0');
					if (d.reboot_time) c.set('gl_timer', 'reboot', 'time', d.reboot_time);
					c.commit('gl_timer');
				}
			}

			return { ok: true };
		}
	}
};

