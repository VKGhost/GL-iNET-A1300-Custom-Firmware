// GL.iNet Feature Suite Backend for OpenWrt 25.12 (rpcd ucode plugin)
// Replicates GL.iNet 4.x backend capabilities natively on OpenWrt 25.12 UCI/ubus/fw4

'use strict';

import { access, open, popen, lsdir, readfile, writefile, mkdir } from 'fs';
import { cursor } from 'uci';
import { connect } from 'ubus';

function String(v) {
	return (v == null) ? '' : sprintf('%s', v);
}

function shellquote(s) {
	return `'${replace(String(s ?? ''), "'", "'\\''")}'`;
}

function run_cmd(cmd) {
	let fd = popen(cmd + ' 2>/dev/null', 'r');
	if (!fd) return '';
	let out = fd.read('all') || '';
	fd.close();
	return trim(out);
}

function run_bg(cmd) {
	system('(' + cmd + ') >/dev/null 2>&1 &');
}

function parse_json_safe(str, fallback) {
	if (!str) return fallback;
	try {
		return json(str);
	} catch (e) {
		return fallback;
	}
}

function get_factory_mac() {
	let mac = trim(readfile('/sys/class/net/wan/address') || readfile('/sys/class/net/eth0/address') || readfile('/sys/class/net/br-lan/address') || '');
	return mac || '94:83:C4:1A:13:00';
}

function get_if_status(ubus_conn, iface) {
	let st = ubus_conn.call(`network.interface.${iface}`, 'status');
	if (!st) return { up: false, proto: '', ipaddr: '', netmask: '', gateway: '', dns: [], device: '' };
	let ipv4 = st['ipv4-address']?.[0] || {};
	let gw = '';
	for (let r in (st.route || [])) {
		if (r.target == '0.0.0.0' && r.mask == 0) {
			gw = r.nexthop;
			break;
		}
	}
	let dns_list = [];
	for (let d in (st['dns-server'] || [])) {
		push(dns_list, d);
	}
	return {
		up: !!st.up,
		proto: st.proto || '',
		ipaddr: ipv4.address || '',
		netmask: ipv4.mask ? `${ipv4.mask}` : '',
		gateway: gw,
		dns: dns_list,
		device: st.l3_device || st.device || ''
	};
}

function parse_wg_conf(conf_text) {
	let ret = {
		private_key: '',
		address: '',
		dns: '',
		mtu: '1420',
		public_key: '',
		preshared_key: '',
		endpoint_host: '',
		endpoint_port: '51820',
		allowed_ips: '0.0.0.0/0',
		persistent_keepalive: '25'
	};
	let sec = '';
	for (let line in split(conf_text, '\n')) {
		line = trim(line);
		if (!length(line) || match(line, /^#/)) continue;
		let m_sec = match(line, /^\[([A-Za-z0-9_-]+)\]/);
		if (m_sec) {
			sec = lc(m_sec[1]);
			continue;
		}
		let eq_idx = index(line, '=');
		if (eq_idx < 1) continue;
		let k = lc(trim(substr(line, 0, eq_idx)));
		let v = trim(substr(line, eq_idx + 1));
		if (sec == 'interface') {
			if (k == 'privatekey') ret.private_key = v;
			else if (k == 'address') ret.address = v;
			else if (k == 'dns') ret.dns = v;
			else if (k == 'mtu') ret.mtu = v;
		} else if (sec == 'peer') {
			if (k == 'publickey') ret.public_key = v;
			else if (k == 'presharedkey') ret.preshared_key = v;
			else if (k == 'endpoint') {
				let ep = split(v, /:/);
				ret.endpoint_host = ep[0];
				if (length(ep) > 1) ret.endpoint_port = ep[1];
			} else if (k == 'allowedips') ret.allowed_ips = v;
			else if (k == 'persistentkeepalive') ret.persistent_keepalive = v;
		}
	}
	return ret;
}

function collect_clients(c, ubus_conn) {
	let clients = [];
	let seen = {};

	let leases_txt = readfile('/tmp/dhcp.leases') || readfile('/var/dhcp.leases') || '';
	for (let line in split(leases_txt, '\n')) {
		line = trim(line);
		if (!length(line)) continue;
		let f = split(line, /\s+/);
		if (length(f) >= 4) {
			let mac = uc(f[1]);
			seen[mac] = {
				ip: f[2],
				hostname: (f[3] != '*') ? f[3] : '',
				mac: mac
			};
		}
	}

	let arp_txt = readfile('/proc/net/arp') || '';
	for (let line in split(arp_txt, '\n')) {
		let f = split(trim(line), /\s+/);
		if (length(f) >= 6 && f[0] != 'IP') {
			let mac = uc(f[3]);
			if (mac != '00:00:00:00:00:00') {
				if (!seen[mac]) {
					seen[mac] = { ip: f[0], hostname: '', mac: mac, dev: f[5] };
				} else {
					seen[mac].dev = f[5];
				}
			}
		}
	}

	let black_macs = c.get('gl-black_white_list', 'black', 'mac') || [];
	if (type(black_macs) == 'string') black_macs = [ black_macs ];

	let qos_rules = {};
	c.foreach('qos', 'queue', function(s) {
		if (s.mac) {
			qos_rules[uc(s.mac)] = {
				upload: int(s.upload || 0),
				download: int(s.download || 0)
			};
		}
	});

	for (let mac in seen) {
		let cl = seen[mac];
		let is_blocked = (index(black_macs, mac) >= 0);
		let q = qos_rules[mac] || { upload: 0, download: 0 };
		push(clients, {
			mac: mac,
			ip: cl.ip || '',
			hostname: cl.hostname || '',
			interface: (cl.dev == 'br-guest') ? 'guest' : 'lan',
			rx_bytes: 0,
			tx_bytes: 0,
			rx_rate: 0,
			tx_rate: 0,
			blocked: is_blocked,
			upload_limit: q.upload,
			download_limit: q.download
		});
	}

	return clients;
}

function parse_iw_scan(txt, dev) {
	let cells = [];
	let current = null;
	for (let line in split(txt, '\n')) {
		let m_bss = match(line, /^BSS ([0-9a-fA-F:]{17})/);
		if (m_bss) {
			if (current && current.ssid) push(cells, current);
			current = { bssid: m_bss[1], ssid: '', signal: -80, channel: 0, device: dev, encryption: { enabled: false } };
			continue;
		}
		if (!current) continue;
		let m_sig = match(line, /signal: (-?[0-9.]+) dBm/);
		if (m_sig) current.signal = int(m_sig[1]);
		let m_ssid = match(line, /SSID: (.*)$/);
		if (m_ssid) current.ssid = trim(m_ssid[1]);
		let m_ds = match(line, /DS Parameter set: channel ([0-9]+)/);
		if (m_ds) current.channel = int(m_ds[1]);
		let m_prim = match(line, /primary channel: ([0-9]+)/);
		if (m_prim) current.channel = int(m_prim[1]);
		if (match(line, /RSN:|WPA:/)) current.encryption.enabled = true;
	}
	if (current && current.ssid) push(cells, current);
	return cells;
}

const methods = {
	get_dashboard: {
		call: function() {
			let c = cursor();
			let ubus_conn = connect();

			let wan_st = get_if_status(ubus_conn, 'wan');
			let wwan_st = get_if_status(ubus_conn, 'wwan');
			let teth_st = get_if_status(ubus_conn, 'tethering');
			let modem_st = get_if_status(ubus_conn, 'modem');

			let sys_info = ubus_conn.call('system', 'info') || {};
			let board_info = ubus_conn.call('system', 'board') || {};

			let repeater_known = [];
			c.foreach('repeater', 'sta', function(s) {
				push(repeater_known, {
					id: s['.name'],
					ssid: s.ssid || '',
					bssid: s.bssid || '',
					encryption: s.encryption || 'none',
					device: s.device || 'radio0',
					channel: s.channel || ''
				});
			});

			let conn_ssid = c.get('repeater', 'general', 'connected_ssid') || '';
			if (!conn_ssid) {
				c.foreach('wireless', 'wifi-iface', function(s) {
					if (s.mode == 'sta' && s.disabled != '1' && s.ssid) conn_ssid = s.ssid;
				});
			}
			let cur_mac = trim(readfile('/sys/class/net/wan/address') || readfile('/sys/class/net/br-lan/address') || '');
			let f_mac = get_factory_mac();

			let cur_temp = 42;
			let t_raw = readfile('/sys/class/thermal/thermal_zone0/temp');
			if (t_raw) cur_temp = int(int(trim(t_raw)) / 1000);

			let clients_list = collect_clients(c, ubus_conn);
			let lan_count = 0;
			let guest_count = 0;
			let blocked_count = 0;
			for (let cl in clients_list) {
				if (cl.blocked) blocked_count++;
				if (cl.interface == 'guest') guest_count++;
				else lan_count++;
			}

			let wg_client_up = (get_if_status(ubus_conn, 'wgclient').up == true);

			return {
				system: {
					model: board_info.model || 'GL.iNet GL-A1300',
					release: board_info.release?.description || 'OpenWrt 25.12',
					uptime: sys_info.uptime || 0,
					load: sys_info.load || [0, 0, 0],
					mem_total: sys_info.memory?.total || 0,
					mem_free: sys_info.memory?.free || 0,
					mem_used_pct: sys_info.memory ? int(((sys_info.memory.total - sys_info.memory.free) * 100) / sys_info.memory.total) : 0,
					temp_c: cur_temp,
					switch_func: c.get('switch-button', 'main', 'func') || 'wifi',
					switch_state: trim(readfile('/var/run/gl_switch_state') || 'on'),
					netmode: c.get('glconfig', 'general', 'mode') || 'router'
				},
				internet: {
					wan: {
						up: wan_st.up,
						ipaddr: wan_st.ipaddr,
						mask: wan_st.netmask,
						gateway: wan_st.gateway,
						dns: wan_st.dns,
						macaddr: cur_mac,
						proto: wan_st.proto,
						uci_proto: c.get('network', 'wan', 'proto') || 'dhcp'
					},
					repeater: {
						enable: (c.get('repeater', 'general', 'enabled') == '1') || wwan_st.up,
						up: wwan_st.up,
						ssid: conn_ssid,
						bssid: c.get('repeater', 'general', 'connected_bssid') || '',
						encryption: c.get('repeater', 'general', 'connected_enc') || '',
						ipaddr: wwan_st.ipaddr,
						gateway: wwan_st.gateway,
						auto: (c.get('repeater', 'general', 'auto') != '0'),
						known_networks: repeater_known
					},
					tethering: {
						enable: (c.get('network', 'tethering', 'disabled') != '1'),
						up: teth_st.up,
						ipaddr: teth_st.ipaddr,
						device: 'usb0',
						usb_power: (c.get('glconfig', 'general', 'usb_power') != '0')
					},
					modem: {
						enable: (c.get('glmodem', 'general', 'enable') == '1'),
						up: modem_st.up,
						ipaddr: modem_st.ipaddr,
						apn: c.get('glmodem', 'general', 'apn') || 'internet',
						pincode: c.get('glmodem', 'general', 'pin') || ''
					},
					multiwan: {
						enabled: (c.get('kmwan', 'general', 'enabled') == '1'),
						mode: c.get('kmwan', 'general', 'mode') || 'failover',
						default_wan: c.get('kmwan', 'general', 'default_wan') || 'wan'
					},
					macclone: {
						factory_mac: f_mac,
						mac: cur_mac,
						mode: c.get('gl_macclone', 'mac', 'mode') || '0'
					}
				},
				vpn: {
					wg_client_enabled: (c.get('wireguard', 'global', 'enabled') == '1'),
					wg_client_up: wg_client_up,
					wg_ip: get_if_status(ubus_conn, 'wgclient').ipaddr,
					wg_server_enabled: (c.get('wireguard_server', 'main_server', 'enable') == '1'),
					ovpn_client_enabled: (c.get('ovpnclient', 'global', 'enable') == '1'),
					kill_switch: (c.get('vpnpolicy', 'global', 'kill_switch') == '1'),
					tailscale_enabled: (c.get('tailscale', 'settings', 'enabled') == '1'),
					zerotier_enabled: (c.get('zerotier', 'gl', 'enabled') == '1')
				},
				clients_summary: {
					total: length(clients_list),
					lan_count: lan_count,
					guest_count: guest_count,
					blocked_count: blocked_count
				}
			};
		}
	},

	set_wan: {
		args: {
			proto: "",
			ipaddr: "",
			netmask: "",
			gateway: "",
			dns: "",
			username: "",
			password: "",
			mtu: "",
			vlan: ""
		},
		call: function(req) {
			let a = req.args || {};
			let proto = a.proto || 'dhcp';
			let c = cursor();

			c.set('network', 'wan', 'proto', proto);
			if (proto == 'static') {
				if (a.ipaddr) c.set('network', 'wan', 'ipaddr', a.ipaddr);
				if (a.netmask) c.set('network', 'wan', 'netmask', a.netmask);
				if (a.gateway) c.set('network', 'wan', 'gateway', a.gateway);
				if (a.dns) {
					let d_list = split(trim(a.dns), /[\s,]+/);
					c.set('network', 'wan', 'dns', filter(d_list, x => length(x) > 0));
				}
			} else if (proto == 'pppoe') {
				if (a.username) c.set('network', 'wan', 'username', a.username);
				if (a.password) c.set('network', 'wan', 'password', a.password);
			}

			if (a.mtu) {
				c.set('network', 'wan', 'mtu', String(int(a.mtu)));
			}

			c.commit('network');
			run_bg('/etc/init.d/network reload');
			return { ok: true };
		}
	},

	scan_wifi: {
		args: { band: "" },
		call: function(req) {
			let c = cursor();
			let ubus_conn = connect();
			let results = [];
			let seen = {};

			let ifaces = [];
			let ubus_devs = ubus_conn.call('iwinfo', 'devices');
			for (let d in (ubus_devs?.devices || [])) {
				if (index(ifaces, d) < 0) push(ifaces, d);
			}

			for (let dev in lsdir('/sys/class/net')) {
				if (match(dev, /^(wlan|ath|ra)/) && access('/sys/class/net/' + dev + '/phy80211') && index(ifaces, dev) < 0) {
					push(ifaces, dev);
				}
			}

			if (!length(ifaces)) {
				for (let phy in lsdir('/sys/class/ieee80211')) {
					let tmp_if = 'glscan_' + phy;
					run_cmd('iw phy ' + shellquote(phy) + ' interface add ' + shellquote(tmp_if) + ' type station 2>/dev/null && ip link set dev ' + shellquote(tmp_if) + ' up 2>/dev/null');
					if (access('/sys/class/net/' + tmp_if)) {
						push(ifaces, tmp_if);
					}
				}
			}

			for (let dev in ifaces) {
				let res = ubus_conn.call('iwinfo', 'scan', { device: dev });
				let cells = res?.results;

				if (res == null) {
					let cli_out = run_cmd('iwinfo -j ' + shellquote(dev) + ' scan 2>/dev/null');
					cells = parse_json_safe(cli_out, null);
					if (!cells || !length(cells)) {
						let iw_out = run_cmd('iw dev ' + shellquote(dev) + ' scan 2>/dev/null');
						if (iw_out && length(iw_out) > 50) {
							cells = parse_iw_scan(iw_out, dev);
						}
					}
				}

				for (let cell in (cells || [])) {
					if (!cell.ssid || trim(cell.ssid) == '') continue;
					let key = cell.ssid + '|' + (cell.bssid || '');
					if (seen[key]) continue;
					seen[key] = true;

					let enc = cell.encryption || cell.crypto || {};
					let enc_uci = 'none';
					let enc_desc = 'Open';
					if (enc.enabled || (enc.key_mgmt && length(enc.key_mgmt))) {
						let km = join(' ', enc.key_mgmt || []);
						let wpa_list = enc.wpa || [];
						if (match(km, /SAE|WPA3/) || index(wpa_list, 3) >= 0) {
							enc_uci = 'sae';
							enc_desc = 'WPA3-SAE';
						} else if (match(km, /PSK|WPA2/) || index(wpa_list, 2) >= 0) {
							enc_uci = 'psk2';
							enc_desc = 'WPA2-PSK';
						} else {
							enc_uci = 'psk-mixed';
							enc_desc = 'WPA/WPA2-Mixed';
						}
					}

					let ch = cell.channel || 0;
					let sig = cell.signal || cell.dbm || -80;
					let b_name = (ch > 14 || cell.band == '5' || match(String(cell.frequency || ''), /^5/)) ? '5GHz' : '2.4GHz';

					if (req.args?.band && req.args.band != 'auto') {
						if (req.args.band == '5g' && b_name != '5GHz') continue;
						if (req.args.band == '2g' && b_name != '2.4GHz') continue;
					}

					push(results, {
						ssid: cell.ssid,
						bssid: cell.bssid || '',
						channel: ch,
						band: b_name,
						device: dev,
						signal: sig,
						quality: cell.quality || 0,
						quality_max: cell.quality_max || 70,
						encryption_uci: enc_uci,
						encryption_desc: enc_desc
					});
				}
			}

			for (let dev in ifaces) {
				if (match(dev, /^glscan_/)) {
					run_cmd('iw dev ' + shellquote(dev) + ' del 2>/dev/null');
				}
			}

			if (!length(results)) {
				run_bg('wifi reload; wifi up');
			}

			sort(results, (a, b) => (b.signal - a.signal));
			return { networks: results };
		}
	},

	connect_repeater: {
		args: {
			ssid: "",
			key: "",
			encryption: "",
			bssid: "",
			device: "",
			lock_bssid: true,
			remember: true,
			proto: "",
			ipaddr: "",
			netmask: "",
			gateway: ""
		},
		call: function(req) {
			let a = req.args || {};
			if (!a.ssid) return { error: 'SSID is required' };
			let c = cursor();

			let r_dev = a.device || 'radio0';
			let sta_sec = 'sta_' + r_dev;

			c.set('wireless', sta_sec, 'wifi-iface');
			c.set('wireless', sta_sec, 'device', r_dev);
			c.set('wireless', sta_sec, 'mode', 'sta');
			c.set('wireless', sta_sec, 'network', 'wwan');
			c.set('wireless', sta_sec, 'ssid', a.ssid);
			c.set('wireless', sta_sec, 'encryption', a.encryption || 'psk2');
			if (a.encryption != 'none' && a.key) {
				c.set('wireless', sta_sec, 'key', a.key);
			} else {
				c.delete('wireless', sta_sec, 'key');
			}
			if (a.lock_bssid && a.bssid) {
				c.set('wireless', sta_sec, 'bssid', a.bssid);
			} else {
				c.delete('wireless', sta_sec, 'bssid');
			}
			c.set('wireless', sta_sec, 'disabled', '0');
			c.set('wireless', r_dev, 'disabled', '0');
			c.commit('wireless');

			c.set('network', 'wwan', 'interface');
			c.set('network', 'wwan', 'proto', a.proto || 'dhcp');
			c.set('network', 'wwan', 'disabled', '0');
			c.set('network', 'wwan', 'metric', '20');
			if (a.proto == 'static') {
				if (a.ipaddr) c.set('network', 'wwan', 'ipaddr', a.ipaddr);
				if (a.netmask) c.set('network', 'wwan', 'netmask', a.netmask);
				if (a.gateway) c.set('network', 'wwan', 'gateway', a.gateway);
			}
			c.commit('network');

			c.set('repeater', 'general', 'enabled', '1');
			c.set('repeater', 'general', 'connected_ssid', a.ssid);
			c.set('repeater', 'general', 'connected_bssid', a.bssid || '');
			c.set('repeater', 'general', 'connected_enc', a.encryption || '');
			c.set('repeater', 'general', 'device', r_dev);

			if (a.remember != false) {
				let s_id = 'net_' + replace(a.ssid, /[^A-Za-z0-9_]/g, '_');
				c.set('repeater', s_id, 'sta');
				c.set('repeater', s_id, 'ssid', a.ssid);
				c.set('repeater', s_id, 'encryption', a.encryption || 'psk2');
				c.set('repeater', s_id, 'key', a.key || '');
				c.set('repeater', s_id, 'device', r_dev);
				if (a.bssid) c.set('repeater', s_id, 'bssid', a.bssid);
			}
			c.commit('repeater');

			run_bg('wifi reload; wifi up; /etc/init.d/network reload; /etc/init.d/gl-repeater restart');
			return { ok: true };
		}
	},

	manage_repeater: {
		args: {
			action: "",
			section: "",
			auto: true,
			band: "",
			scan_interval: 0
		},
		call: function(req) {
			let a = req.args || {};
			let c = cursor();

			if (a.action == 'disconnect') {
				c.set('repeater', 'general', 'enabled', '0');
				c.commit('repeater');
				c.foreach('wireless', 'wifi-iface', function(s) {
					if (s.mode == 'sta') {
						c.set('wireless', s['.name'], 'disabled', '1');
					}
				});
				c.commit('wireless');
				c.set('network', 'wwan', 'disabled', '1');
				c.commit('network');
				run_bg('wifi reload; /etc/init.d/network reload');
			} else if (a.action == 'delete_saved' && a.section) {
				c.delete('repeater', a.section);
				c.commit('repeater');
			} else if (a.action == 'set_auto') {
				c.set('repeater', 'general', 'auto', a.auto ? '1' : '0');
				if (a.scan_interval) c.set('repeater', 'general', 'scan_interval', String(int(a.scan_interval)));
				c.commit('repeater');
			}

			return { ok: true };
		}
	},

	set_tethering_modem: {
		args: {
			tethering_enabled: true,
			tethering_device: "",
			usb_power: true,
			modem_enable: true,
			apn: "",
