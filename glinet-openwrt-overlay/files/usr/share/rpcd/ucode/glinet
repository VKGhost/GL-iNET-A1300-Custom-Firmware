	save_vpn: {
		args: {
			section_type: "",
			data: {}
		},
		call: function(req) {
			let stype = req.args?.section_type || '';
			let d = req.args?.data || {};
			let c = cursor();

			if (stype == 'wg_client') {
				if (d.action == 'import' && d.name && d.conf_text) {
					let p = parse_wg_conf(d.conf_text);
					let pid = 'wg_' + replace(d.name, /[^A-Za-z0-9_]/g, '_');
					c.set('wireguard', pid, 'peers');
					c.set('wireguard', pid, 'name', d.name);
					c.set('wireguard', pid, 'private_key', p.private_key);
					c.set('wireguard', pid, 'address_v4', p.address);
					c.set('wireguard', pid, 'dns', p.dns);
					c.set('wireguard', pid, 'mtu', p.mtu || '1420');
					c.set('wireguard', pid, 'public_key', p.public_key);
					c.set('wireguard', pid, 'preshared_key', p.preshared_key);
					c.set('wireguard', pid, 'endpoint_host', p.endpoint_host);
					c.set('wireguard', pid, 'endpoint_port', p.endpoint_port || '51820');
					c.set('wireguard', pid, 'allowed_ips', p.allowed_ips || '0.0.0.0/0');
					c.set('wireguard', pid, 'persistent_keepalive', p.persistent_keepalive || '25');
					c.set('wireguard', 'global', 'active_profile', pid);
					c.commit('wireguard');
					return { ok: true };
				}

				if (d.enable != null) {
					c.set('wireguard', 'global', 'enabled', d.enable ? '1' : '0');
				}
				if (d.active_profile) {
					c.set('wireguard', 'global', 'active_profile', d.active_profile);
				}
				c.commit('wireguard');

				let active_pid = c.get('wireguard', 'global', 'active_profile');
				let is_en = (c.get('wireguard', 'global', 'enabled') == '1');

				if (active_pid && is_en) {
					let s = c.get_all('wireguard', active_pid);
					if (s) {
						c.set('network', 'wgclient', 'interface');
						c.set('network', 'wgclient', 'proto', 'wireguard');
						c.set('network', 'wgclient', 'private_key', s.private_key || '');
						c.set('network', 'wgclient', 'addresses', [ s.address_v4 || '10.2.0.2/32' ]);
						if (s.dns) c.set('network', 'wgclient', 'dns', split(s.dns, /[\s,]+/));
						c.set('network', 'wgclient', 'metric', '5');
						c.set('network', 'wgclient', 'disabled', '0');

						c.set('network', 'wgserver_peer', 'wireguard_wgclient');
						c.set('network', 'wgserver_peer', 'public_key', s.public_key || '');
						if (s.preshared_key) c.set('network', 'wgserver_peer', 'preshared_key', s.preshared_key);
						else c.delete('network', 'wgserver_peer', 'preshared_key');
						c.set('network', 'wgserver_peer', 'endpoint_host', s.endpoint_host || '');
						c.set('network', 'wgserver_peer', 'endpoint_port', s.endpoint_port || '51820');
						c.set('network', 'wgserver_peer', 'allowed_ips', [ s.allowed_ips || '0.0.0.0/0' ]);
						c.set('network', 'wgserver_peer', 'route_allowed_ips', '1');
						c.set('network', 'wgserver_peer', 'persistent_keepalive', s.persistent_keepalive || '25');
						c.set('network', 'wgserver_peer', 'disabled', '0');
						c.commit('network');

						c.set('firewall', 'vpn_zone', 'zone');
						c.set('firewall', 'vpn_zone', 'name', 'vpn');
						c.set('firewall', 'vpn_zone', 'input', 'REJECT');
						c.set('firewall', 'vpn_zone', 'output', 'ACCEPT');
						c.set('firewall', 'vpn_zone', 'forward', 'REJECT');
						c.set('firewall', 'vpn_zone', 'masq', '1');
						c.set('firewall', 'vpn_zone', 'mtu_fix', '1');
						c.set('firewall', 'vpn_zone', 'network', [ 'wgclient', 'ovpnclient', 'wg0', 'wireguard' ]);

						c.set('firewall', 'lan_vpn', 'forwarding');
						c.set('firewall', 'lan_vpn', 'src', 'lan');
						c.set('firewall', 'lan_vpn', 'dest', 'vpn');
						c.commit('firewall');
					}
				} else {
					c.set('network', 'wgclient', 'disabled', '1');
					c.commit('network');
				}
				run_bg('/etc/init.d/network reload; /etc/init.d/gl-vpnpolicy reload');
			} else if (stype == 'wg_server') {
				if (d.action == 'add_peer' && d.name) {
					let pid = 'peer_' + replace(d.name, /[^A-Za-z0-9_]/g, '_');
					let priv = run_cmd('wg genkey');
					let pub = priv ? run_cmd(`echo ${priv} | wg pubkey`) : '';
					c.set('wireguard_server', pid, 'peers');
					c.set('wireguard_server', pid, 'name', d.name);
					c.set('wireguard_server', pid, 'client_ip', d.client_ip || '10.0.0.2/32');
					c.set('wireguard_server', pid, 'private_key', priv);
					c.set('wireguard_server', pid, 'public_key', pub);
					c.commit('wireguard_server');
					return { ok: true };
				} else if (d.action == 'del_peer' && d.peer_id) {
					c.delete('wireguard_server', d.peer_id);
					c.commit('wireguard_server');
					return { ok: true };
				}

				c.set('wireguard_server', 'main_server', 'enable', d.enable ? '1' : '0');
				if (d.address_v4) c.set('wireguard_server', 'main_server', 'address_v4', d.address_v4);
				if (d.port) c.set('wireguard_server', 'main_server', 'port', String(int(d.port)));
				c.commit('wireguard_server');

				c.set('network', 'wgserver', 'interface');
				c.set('network', 'wgserver', 'proto', 'wireguard');
				c.set('network', 'wgserver', 'private_key', c.get('wireguard_server', 'main_server', 'private_key') || '');
				c.set('network', 'wgserver', 'listen_port', c.get('wireguard_server', 'main_server', 'port') || '51820');
				c.set('network', 'wgserver', 'addresses', [ c.get('wireguard_server', 'main_server', 'address_v4') || '10.0.0.1/24' ]);
				c.set('network', 'wgserver', 'disabled', d.enable ? '0' : '1');
				c.commit('network');
				run_bg('/etc/init.d/network reload');
			} else if (stype == 'openvpn') {
				if (d.ovpn_text && d.profile_name) {
					mkdir('/etc/openvpn', 0755);
					let pid = 'ovpn_' + replace(d.profile_name, /[^A-Za-z0-9_]/g, '_');
					let path = `/etc/openvpn/${pid}.ovpn`;
					writefile(path, d.ovpn_text);
					c.set('ovpnclient', pid, 'clients');
					c.set('ovpnclient', pid, 'name', d.profile_name);
					c.set('ovpnclient', pid, 'config', path);
					if (d.username) c.set('ovpnclient', pid, 'username', d.username);
					c.set('ovpnclient', 'global', 'active_profile', pid);
				}
				if (d.client_enable != null) {
					c.set('ovpnclient', 'global', 'enable', d.client_enable ? '1' : '0');
				}
				if (d.server_enable != null) {
					c.set('ovpnserver', 'global', 'enable', d.server_enable ? '1' : '0');
					if (d.server_port) c.set('ovpnserver', 'vpn', 'port', String(int(d.server_port)));
					if (d.server_proto) c.set('ovpnserver', 'vpn', 'proto', d.server_proto);
					if (d.server_subnet) c.set('ovpnserver', 'vpn', 'subnetv4', d.server_subnet);
				}
				c.commit('ovpnclient');
				c.commit('ovpnserver');
				run_bg('[ -x /etc/init.d/openvpn ] && /etc/init.d/openvpn restart; /etc/init.d/gl-vpnpolicy reload');
			} else if (stype == 'policy') {
				c.set('vpnpolicy', 'global', 'kill_switch', d.kill_switch ? '1' : '0');
				c.set('vpnpolicy', 'global', 'wan_access', d.wan_access ? '1' : '0');
				c.set('vpnpolicy', 'global', 'service_policy', d.service_policy ? '1' : '0');
				c.set('vpnpolicy', 'route_policy', 'proxy_mode', d.proxy_mode || '0');
				c.set('vpnpolicy', 'route_policy', 'mode', d.mode || 'global');
				c.set('vpnpolicy', 'route_policy', 'rule_type', d.rule_type || 'bypass');
				if (d.mac_list != null) {
					let ml = split(trim(String(d.mac_list)), /[\s,]+/);
					c.set('vpnpolicy', 'route_policy', 'mac_list', filter(ml, x => length(x) > 0));
				}
				if (d.domain_list != null) {
					let dl = split(trim(String(d.domain_list)), /[\s,]+/);
					c.set('vpnpolicy', 'route_policy', 'domain_list', filter(dl, x => length(x) > 0));
				}
				if (d.guest_vpn != null) {
					c.set('vpnpolicy', 'vlan', 'guest', d.guest_vpn ? '1' : '0');
				}
				c.commit('vpnpolicy');
				run_bg('/etc/init.d/gl-vpnpolicy reload');
			} else if (stype == 'mesh') {
				if (d.tailscale_enabled != null) {
					c.set('tailscale', 'settings', 'enabled', d.tailscale_enabled ? '1' : '0');
					c.set('tailscale', 'settings', 'lan_enabled', d.tailscale_lan ? '1' : '0');
					c.set('tailscale', 'settings', 'wan_enabled', d.tailscale_wan ? '1' : '0');
					c.set('tailscale', 'settings', 'exit_node_ip', d.tailscale_exit_node || '');
					c.set('tailscale', 'settings', 'auth_key', d.tailscale_auth_key || '');
					c.commit('tailscale');
					run_bg('[ -x /etc/init.d/tailscale ] && /etc/init.d/tailscale restart');
				}
				if (d.zerotier_enabled != null) {
					c.set('zerotier', 'gl', 'enabled', d.zerotier_enabled ? '1' : '0');
					c.set('zerotier', 'gl', 'lan_enabled', d.zerotier_lan ? '1' : '0');
					c.set('zerotier', 'gl', 'wan_enabled', d.zerotier_wan ? '1' : '0');
					if (d.zerotier_id != null) {
						c.set('zerotier', 'gl', 'join', d.zerotier_id ? [ d.zerotier_id ] : []);
					}
					c.commit('zerotier');
					run_bg('[ -x /etc/init.d/zerotier ] && /etc/init.d/zerotier restart');
				}
				if (d.tor_enabled != null) {
					c.set('tor', 'global', 'enable', d.tor_enabled ? '1' : '0');
					if (d.tor_countries) c.set('tor', 'global', 'countries', d.tor_countries);
					c.commit('tor');
					run_bg('[ -x /etc/init.d/tor ] && /etc/init.d/tor restart');
				}
			}

			return { ok: true };
		}
	},

	get_clients_qos: {
		call: function() {
			let c = cursor();
			let ubus_conn = connect();
			let clients = collect_clients(c, ubus_conn);

			let black_macs = c.get('gl-black_white_list', 'black', 'mac') || [];
			if (type(black_macs) == 'string') black_macs = [ black_macs ];
			let white_macs = c.get('gl-black_white_list', 'white', 'mac') || [];
			if (type(white_macs) == 'string') white_macs = [ white_macs ];

			let pc_macs = c.get('parental_control', 'global', 'blocked_macs') || [];
			if (type(pc_macs) == 'string') pc_macs = [ pc_macs ];
			let pc_domains = c.get('parental_control', 'global', 'blocked_domains') || [];
			if (type(pc_domains) == 'string') pc_domains = [ pc_domains ];

			return {
				clients: clients,
				blocklist: {
					enable: (c.get('gl-black_white_list', 'global', 'enable') != '0'),
					mode: c.get('gl-black_white_list', 'global', 'mode') || 'black',
					black_macs: black_macs,
					white_macs: white_macs,
					lan_isolate: (c.get('gl-black_white_list', 'lan', 'ap_isolate') == '1'),
					guest_isolate: (c.get('gl-black_white_list', 'guest', 'ap_isolate') != '0')
				},
				qos: {
					enable: (c.get('qos', 'general', 'enable') == '1'),
					model: c.get('qos', 'general', 'model') || 'cake',
					upload: int(c.get('qos', 'general', 'upload') || 100),
					download: int(c.get('qos', 'general', 'download') || 100)
				},
				parental: {
					enable: (c.get('parental_control', 'global', 'enable') == '1'),
					blocked_macs: pc_macs,
					blocked_domains: pc_domains
				}
			};
		}
	},

	save_clients_qos: {
		args: {
			action: "",
			mac: "",
			blocked: true,
			upload_limit: 0,
			download_limit: 0,
			hostname: "",
			data: {}
		},
		call: function(req) {
			let a = req.args || {};
			let c = cursor();

			if (a.action == 'client_rule' && a.mac) {
				let umac = uc(trim(a.mac));
				let bmacs = c.get('gl-black_white_list', 'black', 'mac') || [];
				if (type(bmacs) == 'string') bmacs = [ bmacs ];
				let next_bmacs = filter(bmacs, m => uc(trim(m)) != umac);
				if (a.blocked) push(next_bmacs, umac);
				c.set('gl-black_white_list', 'black', 'mac', next_bmacs);
				c.commit('gl-black_white_list');

				let qid = 'q_' + replace(umac, /:/g, '');
				if ((a.upload_limit && a.upload_limit > 0) || (a.download_limit && a.download_limit > 0)) {
					c.set('qos', qid, 'queue');
					c.set('qos', qid, 'mac', umac);
					c.set('qos', qid, 'name', a.hostname || umac);
					c.set('qos', qid, 'upload', String(int(a.upload_limit || 0)));
					c.set('qos', qid, 'download', String(int(a.download_limit || 0)));
				} else {
					c.delete('qos', qid);
				}
				c.commit('qos');
				run_bg('/etc/init.d/gl-firewall-addons reload');
				return { ok: true };
			}

			let d = a.data || {};
			if (d.bw_enable != null) {
				c.set('gl-black_white_list', 'global', 'enable', d.bw_enable ? '1' : '0');
				c.set('gl-black_white_list', 'global', 'mode', d.bw_mode || 'black');
				if (d.black_macs != null) {
					let bm = filter(split(uc(trim(String(d.black_macs))), /[\s,]+/), x => length(x) > 0);
					c.set('gl-black_white_list', 'black', 'mac', bm);
				}
				if (d.white_macs != null) {
					let wm = filter(split(uc(trim(String(d.white_macs))), /[\s,]+/), x => length(x) > 0);
					c.set('gl-black_white_list', 'white', 'mac', wm);
				}
				c.commit('gl-black_white_list');
			}
			if (d.qos_enable != null) {
				c.set('qos', 'general', 'enable', d.qos_enable ? '1' : '0');
				if (d.qos_upload != null) c.set('qos', 'general', 'upload', String(int(d.qos_upload)));
				if (d.qos_download != null) c.set('qos', 'general', 'download', String(int(d.qos_download)));
				c.commit('qos');
			}
			if (d.pc_enable != null) {
				c.set('parental_control', 'global', 'enable', d.pc_enable ? '1' : '0');
				if (d.pc_macs != null) {
					let pm = filter(split(uc(trim(String(d.pc_macs))), /[\s,]+/), x => length(x) > 0);
					c.set('parental_control', 'global', 'blocked_macs', pm);
				}
				if (d.pc_domains != null) {
					let pd = filter(split(trim(String(d.pc_domains)), /[\s,]+/), x => length(x) > 0);
					c.set('parental_control', 'global', 'blocked_domains', pd);
				}
				c.commit('parental_control');
			}

			run_bg('/etc/init.d/gl-firewall-addons reload');
			return { ok: true };
		}
	},

	get_network_dns: {
		call: function() {
			let c = cursor();
			let static_leases = [];
			c.foreach('dhcp', 'host', function(s) {
				push(static_leases, {
					id: s['.name'],
					name: s.name || '',
					mac: (type(s.mac) == 'array') ? s.mac[0] : (s.mac || ''),
					ip: s.ip || ''
				});
			});

			return {
				lan: {
					ipaddr: c.get('network', 'lan', 'ipaddr') || '192.168.8.1',
					netmask: c.get('network', 'lan', 'netmask') || '255.255.255.0',
					dhcp_start: int(c.get('dhcp', 'lan', 'start') || 100),
					dhcp_limit: int(c.get('dhcp', 'lan', 'limit') || 150),
					dhcp_leasetime: c.get('dhcp', 'lan', 'leasetime') || '12h',
					dhcp_ignore: (c.get('dhcp', 'lan', 'ignore') == '1'),
					static_leases: static_leases
				},
				dns: {
					mode: c.get('gl-dns', 'dns', 'mode') || 'auto',
					manual_dns1: c.get('gl-dns', 'dns', 'manual_dns1') || '1.1.1.1',
					manual_dns2: c.get('gl-dns', 'dns', 'manual_dns2') || '8.8.8.8',
					dot_provider: c.get('gl-dns', 'dns', 'dot_provider') || 'cloudflare',
					doh_provider: c.get('gl-dns', 'dns', 'doh_provider') || 'cloudflare',
					override_vpn: (c.get('gl-dns', 'dns', 'override_vpn') == '1'),
					force_dns: (c.get('gl-dns', 'dns', 'force_dns') == '1'),
					rebind_protection: (c.get('dhcp', '@dnsmasq[0]', 'rebind_protection') != '0')
				},
				adguardhome: {
					enabled: (c.get('adguardhome', 'config', 'enabled') == '1'),
					port: c.get('adguardhome', 'config', 'port') || '3000',
					dns_port: c.get('adguardhome', 'config', 'dns_port') || '3053',
					handle_client_requests: (c.get('adguardhome', 'config', 'handle_client_requests') == '1'),
					installed: !!access('/usr/bin/AdGuardHome')
				},
				ipv6: {
					enabled: (c.get('glipv6', 'globals', 'enabled') == '1'),
					wan_addrmode: c.get('glipv6', 'wan', 'addrmode') || 'auto',
					lan_mode: c.get('glipv6', 'lan', 'mode') || 'nat6'
				},
				edgerouter: {
					enabled: (c.get('edgerouter', 'global', 'enabled') == '1'),
					force_dns: (c.get('edgerouter', 'global', 'force_dns') != '0'),
