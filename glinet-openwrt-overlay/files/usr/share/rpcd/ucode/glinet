	set_multiwan_macclone: {
		args: {
			mwan_enable: true,
			mwan_mode: "",
			mwan_interval: 0,
			wan_metric: 0,
			wwan_metric: 0,
			tethering_metric: 0,
			modem_metric: 0,
			track_ip1: "",
			track_ip2: "",
			mac_mode: "",
			mac_addr: ""
		},
		call: function(req) {
			let a = req.args || {};
			let c = cursor();

			if (a.mwan_enable != null) {
				c.set('kmwan', 'general', 'enabled', a.mwan_enable ? '1' : '0');
				if (a.mwan_mode) c.set('kmwan', 'general', 'mode', a.mwan_mode);
				if (a.mwan_interval) c.set('kmwan', 'general', 'interval', String(int(a.mwan_interval)));
				if (a.track_ip1) c.set('kmwan', 'general', 'track_ip1', a.track_ip1);
				if (a.track_ip2) c.set('kmwan', 'general', 'track_ip2', a.track_ip2);
				c.commit('kmwan');
			}

			if (a.wan_metric) c.set('network', 'wan', 'metric', String(int(a.wan_metric)));
			if (a.wwan_metric) c.set('network', 'wwan', 'metric', String(int(a.wwan_metric)));
			if (a.tethering_metric) c.set('network', 'tethering', 'metric', String(int(a.tethering_metric)));
			if (a.modem_metric) c.set('network', 'modem', 'metric', String(int(a.modem_metric)));

			if (a.mac_mode != null) {
				let mode = a.mac_mode;
				c.set('gl_macclone', 'mac', 'mode', mode);
				let final_mac = '';
				if (mode == '0') {
					final_mac = get_factory_mac();
				} else if (mode == '2') {
					let rnd = [];
					for (let i = 0; i < 6; i++) {
						let b = int(rand() * 256);
						if (i == 0) b = (b & 0xfe) | 0x02;
						push(rnd, sprintf('%02X', b));
					}
					final_mac = join(':', rnd);
				} else if (mode == '3' && a.mac_addr) {
					final_mac = uc(trim(a.mac_addr));
				}

				if (final_mac) {
					c.set('gl_macclone', 'mac', 'mac', final_mac);
					c.set('network', 'wan', 'macaddr', final_mac);
					run_bg(`ip link set dev wan address ${final_mac} 2>/dev/null || true`);
				}
				c.commit('gl_macclone');
			}

			c.commit('network');
			run_bg('/etc/init.d/network reload; /etc/init.d/gl-mwan restart');
			return { ok: true };
		}
	},

	get_wifi_config: {
		call: function() {
			let c = cursor();
			let radios = {};
			c.foreach('wireless', 'wifi-device', function(s) {
				let r = s['.name'];
				radios[r] = {
					device: r,
					band: s.band || ((r == 'radio1') ? '5g' : '2g'),
					channel: s.channel || 'auto',
					htmode: s.htmode || '',
					txpower: s.txpower || '',
					country: s.country || 'US',
					disabled: (s.disabled == '1')
				};
			});

			if (!length(radios)) {
				radios['radio0'] = { device: 'radio0', band: '2g', channel: 'auto', htmode: 'HT20', txpower: '20', country: 'US', disabled: false };
				radios['radio1'] = { device: 'radio1', band: '5g', channel: 'auto', htmode: 'VHT80', txpower: '20', country: 'US', disabled: false };
			}

			let ifaces = {};
			c.foreach('wireless', 'wifi-iface', function(s) {
				if (s.mode == 'sta') return;
				let sec = s['.name'];
				let dev = s.device || 'radio0';
				let band = radios[dev]?.band || (dev == 'radio1' ? '5g' : '2g');
				let is_guest = (s.network == 'guest' || match(sec, /guest/));
				let slot = (is_guest ? 'guest_' : 'main_') + ((band == '5g') ? '5g' : '2g');
				ifaces[slot] = {
					section: sec,
					device: dev,
					enabled: (s.disabled != '1'),
					ssid: s.ssid || (is_guest ? 'GL-A1300-Guest' : 'GL-A1300'),
					encryption: s.encryption || 'psk2',
					key: s.key || '',
					hidden: (s.hidden == '1'),
					isolate: (s.isolate == '1'),
					channel: radios[dev]?.channel || 'auto',
					htmode: radios[dev]?.htmode || '',
					txpower: radios[dev]?.txpower || ''
				};
			});

			return {
				radios: radios,
				ifaces: ifaces,
				guest_ip: c.get('network', 'guest', 'ipaddr') || '192.168.9.1',
				guest_lan_access: (c.get('gl-black_white_list', 'guest', 'transfer_enable') == '1'),
				schedule_enable: (c.get('gl_timer', 'wifi', 'enable') == '1'),
				schedule_off: c.get('gl_timer', 'wifi', 'off_time') || '23:30',
				schedule_on: c.get('gl_timer', 'wifi', 'on_time') || '06:30'
			};
		}
	},

	set_wifi_config: {
		args: {
			ifaces: {},
			guest_ip: "",
			guest_lan_access: true,
			schedule_enable: true,
			schedule_off: "",
			schedule_on: ""
		},
		call: function(req) {
			let a = req.args || {};
			let c = cursor();
			let ifaces = a.ifaces || {};
			let any_guest_enabled = false;

			for (let slot in ifaces) {
				let cfg = ifaces[slot];
				if (!cfg) continue;
				let dev = cfg.device || ((match(slot, /5g/)) ? 'radio1' : 'radio0');
				let sec = cfg.section;
				let is_guest = match(slot, /^guest_/);

				if (!sec || sec == '' || !c.get('wireless', sec)) {
					c.foreach('wireless', 'wifi-iface', function(s) {
						if (s.mode == 'sta') return;
						let s_guest = (s.network == 'guest' || match(s['.name'], /guest/));
						if (s.device == dev && s_guest == is_guest) {
							sec = s['.name'];
						}
					});
					if (!sec || sec == '') {
						sec = is_guest ? (slot == 'guest_5g' ? 'guest_5g' : 'guest_2g') : ('default_' + dev);
					}
				}

				// Remove any duplicate conflicting AP sections for the same radio and guest status
				c.foreach('wireless', 'wifi-iface', function(s) {
					if (s.mode == 'sta') return;
					let s_guest = (s.network == 'guest' || match(s['.name'], /guest/));
					if (s.device == dev && s_guest == is_guest && s['.name'] != sec) {
						c.delete('wireless', s['.name']);
					}
				});

				c.set('wireless', sec, 'wifi-iface');
				c.set('wireless', sec, 'device', dev);
				c.set('wireless', sec, 'mode', 'ap');
				c.set('wireless', sec, 'network', is_guest ? 'guest' : 'lan');
				c.set('wireless', sec, 'disabled', cfg.enabled ? '0' : '1');
				c.set('wireless', sec, 'ssid', cfg.ssid || 'GL-A1300');
				c.set('wireless', sec, 'encryption', cfg.encryption || 'psk2');
				if (cfg.encryption != 'none' && cfg.key) {
					c.set('wireless', sec, 'key', cfg.key);
				} else if (cfg.encryption == 'none') {
					c.delete('wireless', sec, 'key');
				}
				c.set('wireless', sec, 'hidden', cfg.hidden ? '1' : '0');
				c.set('wireless', sec, 'isolate', cfg.isolate ? '1' : '0');

				if (!is_guest) {
					c.set('wireless', dev, 'wifi-device');
					if (cfg.enabled) {
						c.set('wireless', dev, 'disabled', '0');
					}
					if (cfg.channel && cfg.channel != 'auto') {
						c.set('wireless', dev, 'channel', cfg.channel);
					}
					if (cfg.htmode) c.set('wireless', dev, 'htmode', cfg.htmode);
					if (cfg.txpower != null && cfg.txpower != '') {
						c.set('wireless', dev, 'txpower', String(int(cfg.txpower)));
					}
				} else if (cfg.enabled) {
					any_guest_enabled = true;
				}
			}

			c.set('network', 'guest', 'disabled', any_guest_enabled ? '0' : '1');
			if (a.guest_ip) {
				c.set('network', 'guest', 'ipaddr', a.guest_ip);
			}
			if (a.guest_lan_access != null) {
				c.set('gl-black_white_list', 'guest', 'transfer_enable', a.guest_lan_access ? '1' : '0');
			}
			if (a.schedule_enable != null) {
				c.set('gl_timer', 'wifi', 'enable', a.schedule_enable ? '1' : '0');
				if (a.schedule_off) c.set('gl_timer', 'wifi', 'off_time', a.schedule_off);
				if (a.schedule_on) c.set('gl_timer', 'wifi', 'on_time', a.schedule_on);
			}

			c.commit('wireless');
			c.commit('network');
			c.commit('gl-black_white_list');
			c.commit('gl_timer');

			run_bg('wifi reload; wifi up; /etc/init.d/network reload; /etc/init.d/gl-firewall-addons reload');
			return { ok: true };
		}
	},

